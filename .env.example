# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Run `npm run setup:admin` to generate local admin credentials in .env.local.
# For production, configure AUTH_USERNAME, AUTH_DISPLAY_NAME, AUTH_ROLE,
# AUTH_PASSWORD_SALT, AUTH_PASSWORD_HASH, AUTH_SESSION_SECRET and set
# AUTH_COOKIE_SECURE=true when the app is served over HTTPS.

# Store IDs are non-secret. Connect each store to its corresponding Vercel environment using OIDC.
BLOB_PRODUCTION_STORE_ID="store_your_production_public_store"
BLOB_PREVIEW_STORE_ID="store_your_preview_public_store"

# Private stores hold encrypted platform data. Vercel OIDC provides credentials at runtime.
PRIVATE_BLOB_PRODUCTION_STORE_ID="store_your_production_private_store"
PRIVATE_BLOB_PREVIEW_STORE_ID="store_your_preview_private_store"

# Only needed if legacy encrypted data is in a different public store than Production's board.
# LEGACY_BLOB_STORE_ID="store_your_legacy_public_store"
