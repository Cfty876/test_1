# Copy to .env.production.local (ignored). Keep hexadecimal DB passwords to avoid URL escaping.
PERVIK_DOMAIN=example.org
TLS_EMAIL=admin@example.org
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
AUTH_USERNAME=REPLACE_WITH_ADMIN_LOGIN
AUTH_DISPLAY_NAME=Администратор
AUTH_ROLE=admin
AUTH_PASSWORD_SALT=REPLACE_WITH_EXISTING_SALT
AUTH_PASSWORD_HASH=REPLACE_WITH_EXISTING_HASH
# For existing data, preserve the original key exactly. Changing it loses access to encrypted records.
AUTH_SESSION_SECRET=REPLACE_WITH_EXISTING_SESSION_SECRET
AUTH_COOKIE_SECURE=true
